{
  "name": "@openchamber/web-readonly-status",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "launch:start": "powershell -ExecutionPolicy Bypass -File ./scripts/start-readonly-status.ps1",
    "launch:status": "powershell -ExecutionPolicy Bypass -File ./scripts/status-readonly-status.ps1",
    "launch:stop": "powershell -ExecutionPolicy Bypass -File ./scripts/stop-readonly-status.ps1",
    "opencode:local:start": "powershell -ExecutionPolicy Bypass -File ./scripts/start-opencode-local.ps1",
    "opencode:local:status": "powershell -ExecutionPolicy Bypass -File ./scripts/status-opencode-local.ps1",
    "opencode:local:stop": "powershell -ExecutionPolicy Bypass -File ./scripts/stop-opencode-local.ps1",
    "routine:start": "powershell -ExecutionPolicy Bypass -File ./scripts/start-routine-local.ps1",
    "routine:status": "powershell -ExecutionPolicy Bypass -File ./scripts/status-routine-local.ps1",
    "routine:stop": "powershell -ExecutionPolicy Bypass -File ./scripts/stop-routine-local.ps1",
    "typecheck": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "lint": "eslint \"./src/**/*.{ts,tsx}\" --config ../../eslint.config.js"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.2"
